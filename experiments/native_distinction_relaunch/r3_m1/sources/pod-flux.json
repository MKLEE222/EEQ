{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "eeq-r3-flux-probe",
    "namespace": "eeq-r3"
  },
  "spec": {
    "serviceAccountName": "flux",
    "restartPolicy": "Never",
    "securityContext": {
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "probe",
        "image": "registry.k8s.io/pause:3.10",
        "securityContext": {
          "readOnlyRootFilesystem": true
        }
      }
    ]
  }
}
