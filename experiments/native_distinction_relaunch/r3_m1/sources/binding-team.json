{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicyBinding",
  "metadata": {
    "name": "eeq-r3-binding-team"
  },
  "spec": {
    "policyName": "eeq-r3-flux-deny",
    "validationActions": [
      "Deny"
    ],
    "matchResources": {
      "namespaceSelector": {
        "matchLabels": {
          "r3.team": "tenant"
        }
      }
    }
  }
}
