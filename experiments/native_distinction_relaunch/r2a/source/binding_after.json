{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicyBinding",
  "metadata": {
    "name": "eeq-r2a-flux-binding"
  },
  "spec": {
    "policyName": "eeq-r2a-flux-constraint",
    "validationActions": [
      "Deny"
    ],
    "matchResources": {
      "namespaceSelector": {
        "matchLabels": {
          "eeq.r2a/armed": "gate"
        }
      }
    }
  }
}
