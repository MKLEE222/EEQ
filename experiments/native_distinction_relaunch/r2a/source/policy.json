{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicy",
  "metadata": {
    "name": "eeq-r2a-flux-constraint"
  },
  "spec": {
    "failurePolicy": "Fail",
    "matchConstraints": {
      "resourceRules": [
        {
          "apiGroups": [
            ""
          ],
          "apiVersions": [
            "v1"
          ],
          "operations": [
            "CREATE"
          ],
          "resources": [
            "pods"
          ]
        }
      ]
    },
    "validations": [
      {
        "expression": "object.spec.serviceAccountName != 'flux'",
        "message": "EEQ_R2A_REGISTERED_FLUX_DENIAL",
        "reason": "Forbidden"
      }
    ]
  }
}
