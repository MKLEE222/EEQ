{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicy",
  "metadata": {
    "name": "eeq-r3-m3-default-deny"
  },
  "spec": {
    "failurePolicy": "Fail",
    "matchConstraints": {
      "resourceRules": [
        {
          "apiGroups": [
            ""
          ],
          "apiVersions": [
            "v1"
          ],
          "operations": [
            "CREATE"
          ],
          "resources": [
            "pods"
          ]
        }
      ]
    },
    "validations": [
      {
        "expression": "object.spec.serviceAccountName != 'default'",
        "message": "EEQ_R3_M3_DEFAULT_SA_DENIED",
        "reason": "Forbidden"
      }
    ]
  }
}
